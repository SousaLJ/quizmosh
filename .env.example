# Copie para .env e substitua a senha. Ou execute iniciar-docker.bat / scripts/start-docker.sh.
POSTGRES_PASSWORD=SUBSTITUA_POR_UMA_SENHA_ALEATORIA
HTTP_PORT=8080
HTTPS_PORT=8443
SITE_ADDRESS=:80
MAX_ROOMS=250
# Para um domínio público: SITE_ADDRESS=quiz.seudominio.com, HTTP_PORT=80, HTTPS_PORT=443.

# Local HTTP only. Public HTTPS must use true.
SECURE_COOKIES=false
PUBLIC_BASE_URL=http://localhost:8080
# Server-side only. Register both callbacks under PUBLIC_BASE_URL.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_DISCORD_CLIENT_ID=
OAUTH_DISCORD_CLIENT_SECRET=
# JAR/Railway datasource (Compose supplies its own database settings):
# DATABASE_URL=jdbc:postgresql://HOST:5432/quizmosh
# DATABASE_USER=quizmosh
# DATABASE_PASSWORD=
